{
  "name": "note-stats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "collect": "node scripts/collect-note-stats.mjs",
    "auth": "HEADLESS=false node scripts/collect-note-stats.mjs --login-only",
    "check": "node --check scripts/collect-note-stats.mjs",
    "migrate": "node scripts/migrate-csv-to-sqlite.mjs",
    "serve": "node server/server.mjs",
    "dashboard:build": "npm --prefix dashboard install && npm --prefix dashboard run build",
    "dashboard:dev": "npm --prefix dashboard run dev"
  },
  "dependencies": {
    "@openai/codex": "^0.142.5"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
